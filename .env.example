# ============================================================================
# PinSpace v2 — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, and configure the same
# variables in your hosting provider (e.g., Vercel → Project Settings → Env
# Vars) for production. `.env.local` is gitignored and must never be checked
# in. Only the three Supabase keys and PINSPACE_ADMIN_EMAILS need to be set
# manually — VERCEL and NODE_ENV are populated by the platform.
# ============================================================================


# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL
# ----------------------------------------------------------------------------
# What:  Public URL of your Supabase project. Exposed to the browser (the
#        NEXT_PUBLIC_ prefix makes it part of the client bundle), so this is
#        not a secret.
# Used:  lib/supabase/client.ts, lib/supabase/server.ts (and anywhere a
#        Supabase client is constructed).
# Where: Supabase Dashboard → Project Settings → API → "Project URL".
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co


# ----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_ANON_KEY
# ----------------------------------------------------------------------------
# What:  Public "anon" JWT used by browser/server clients to talk to Supabase
#        under Row-Level-Security. Safe to expose to the browser.
# Used:  lib/supabase/client.ts, lib/supabase/server.ts.
# Where: Supabase Dashboard → Project Settings → API → "Project API keys" →
#        anon / public.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here


# ----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY
# ----------------------------------------------------------------------------
# What:  Privileged service-role JWT that bypasses RLS. SECRET — never expose
#        to the browser, never commit, never log.
# Used:  lib/supabase/server.ts (`supabaseServiceRole()`),
#        app/api/explore/studios/route.ts, and admin/RPC routes that need to
#        read across users (e.g. app/api/admin/**).
# Where: Supabase Dashboard → Project Settings → API → "Project API keys" →
#        service_role.
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ----------------------------------------------------------------------------
# PINSPACE_ADMIN_EMAILS
# ----------------------------------------------------------------------------
# What:  Comma-separated allowlist of email addresses that may access /admin
#        routes and admin-only API endpoints. Case-insensitive; whitespace is
#        trimmed.
# Used:  lib/auth/isAdmin.ts (and the API routes that call it, e.g.
#        app/api/admin/institutions/[slug]/stats/route.ts,
#        app/api/debug/**).
# Where: Decide which addresses get admin access and list them here. Example:
#        PINSPACE_ADMIN_EMAILS=alice@school.edu,bob@school.edu
# ----------------------------------------------------------------------------
PINSPACE_ADMIN_EMAILS=admin@yourschool.edu


# ----------------------------------------------------------------------------
# PINSPACE_NOTIFY_EMAIL
# ----------------------------------------------------------------------------
# What:  Single address that receives operational mail the platform sends on its
#        own — feedback submissions and account-deletion requests. NOT an
#        authorization list, and deliberately separate from
#        PINSPACE_ADMIN_EMAILS: that one decides who may CALL the admin routes,
#        this one only decides where notifications land.
# Used:  lib/notifyEmail.ts, read by app/api/feedback/route.ts and
#        app/api/settings/delete-account/route.ts. Sending also needs
#        RESEND_API_KEY; without it no mail is attempted at all.
# Where: Set to the inbox that should receive these. If unset, the code falls
#        back to the original maintainer address and logs a warning at startup,
#        so notifications keep working but the fallback is visible in the logs.
# ----------------------------------------------------------------------------
PINSPACE_NOTIFY_EMAIL=ops@yourschool.edu


# ----------------------------------------------------------------------------
# VERCEL  (set automatically by Vercel — do NOT set manually)
# ----------------------------------------------------------------------------
# What:  Set to "1" by the Vercel build/runtime environment. Absent in local
#        dev. Used to detect whether the app is running on Vercel.
# Used:  next.config.js (`isVercelBuild = process.env.VERCEL === '1' || ...`).
# Where: Provided by the Vercel platform — leave unset locally and in your
#        own .env.local.
# ----------------------------------------------------------------------------
# VERCEL=1


# ----------------------------------------------------------------------------
# NODE_ENV  (set automatically by Next.js — do NOT set manually)
# ----------------------------------------------------------------------------
# What:  "development" during `next dev`, "production" during `next build` /
#        `next start`, "test" under Jest/etc. Setting it yourself can break
#        Next.js's internal assumptions.
# Used:  next.config.js, components/Gallery3D.tsx, components/3d/*.ts(x),
#        and other dev-only logging/guards throughout the codebase.
# Where: Set by Next.js / the runtime — never define this in .env.local or
#        Vercel env vars.
# ----------------------------------------------------------------------------
# NODE_ENV=development
