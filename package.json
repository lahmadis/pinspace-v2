{
  "name": "pinspace-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('public/wasm',{recursive:true});fs.copyFileSync('node_modules/rhino3dm/rhino3dm.js','public/wasm/rhino3dm.js');fs.copyFileSync('node_modules/rhino3dm/rhino3dm.wasm','public/wasm/rhino3dm.wasm')\"",
    "dev": "node scripts/dev-safe-start.js",
    "dev:raw": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "check:pinspace-ui": "node scripts/check-pinspace-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=mobile --project=tablet --project=desktop",
    "test:a11y": "playwright test --project=a11y",
    "test:visual": "playwright test --project=visual"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.87.1",
    "@types/d3": "^7.4.3",
    "@use-gesture/react": "^10.3.1",
    "browser-image-compression": "^2.0.2",
    "d3": "^7.8.5",
    "framer-motion": "11.13.5",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.560.0",
    "next": "^16.3.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rhino3dm": "^8.17.0",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vitest": "^3.2.6"
  }
}
